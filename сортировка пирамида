#include <iostream>
#include <vector>
using namespace std;
void pro(vector <int> &a, int i, int n) {
    while(2*i+1<=n) {
        int r=2*i+1;
        if (r+1<=n && a[r]< a[r+1]) {
            r++;
        }
        if (a[i] < a[r]) {
            int t=a[i];
            a[i] = a[r];
            a[r] = t;
            i=r; 
        }
        else break;
    }
}
int main() {
    int n;
    cin>> n;
    vector <int> a(n);
    for (int i=0; i<n; ++i) {
        cin >> a[i];
    }
    int i=(n)/2;
    while(i>=0) {
        pro(a, i, n-1);
        i--;
    }
    i=n-1;
    while(i>0) {
        int t=a[i];
            a[i] = a[0];
            a[0] = t;
        i--;
         pro(a, 0, i);   
    }
    for (int i=0; i<n; ++i) {
        cout << a[i]<< " "; }
  return 0;  
}
